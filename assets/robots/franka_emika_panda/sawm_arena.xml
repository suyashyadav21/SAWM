<mujoco model="sawm_arena">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.25 0.35 0.5" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.15 0.18 0.22" rgb2="0.10 0.12 0.15"
      markrgb="0.3 0.35 0.4" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>

    <material name="table_mat" rgba="0.22 0.24 0.28 1.0" specular="0.2" shininess="0.1"/>
    <material name="table_top_mat" rgba="0.32 0.35 0.40 1.0" specular="0.3" shininess="0.2"/>
    <material name="target_mat" rgba="0.90 0.25 0.20 1.0" specular="0.5" shininess="0.5"/>
    <material name="goal_mat" rgba="0.20 0.80 0.30 0.5" specular="0.0"/>
  </asset>

  <worldbody>
    <light pos="0.5 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" directional="true"/>
    <light pos="-0.5 -1.0 2.0" dir="0.5 1.0 -1" diffuse="0.4 0.4 0.4" directional="true"/>

    <!-- Floor -->
    <geom name="floor" size="3 3 0.05" type="plane" material="groundplane" contype="1" conaffinity="1"/>

    <!-- Workstation Table (in front of Franka Panda) -->
    <!-- Table top surface is at z = 0.40m -->
    <body name="table" pos="0.55 0 0.2">
      <!-- Main tabletop -->
      <geom name="table_top" type="box" size="0.35 0.45 0.02" pos="0 0 0.18" material="table_top_mat" contype="1" conaffinity="1"/>
      <!-- Table pedestal/legs -->
      <geom name="table_body" type="box" size="0.32 0.42 0.16" pos="0 0 0" material="table_mat" contype="1" conaffinity="1"/>
    </body>

    <!-- Target Object (Movable cube on the table) -->
    <!-- Initial pos: on table top (z = 0.2 + 0.18 + 0.02 + 0.025 = 0.425m) -->
    <body name="target_object" pos="0.55 -0.12 0.425">
      <freejoint name="target_object_joint"/>
      <geom name="target_object_geom" type="box" size="0.025 0.025 0.025" material="target_mat"
            mass="0.1" friction="1.2 0.01 0.001" contype="1" conaffinity="1"/>
    </body>

    <!-- Goal Zone Marker (Visual indicator on table surface) -->
    <body name="goal_zone" pos="0.55 0.20 0.401">
      <geom name="goal_marker" type="cylinder" size="0.06 0.002" material="goal_mat"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Observation Cameras -->
    <camera name="workspace_cam" pos="1.4 -0.8 0.9" xyaxes="0.65 0.76 0 -0.32 0.27 0.91"/>
    <camera name="front_cam" pos="1.3 0 0.7" xyaxes="0 1 0 -0.35 0 0.94"/>
    <camera name="top_cam" pos="0.55 0 1.5" xyaxes="0 1 0 -1 0 0"/>
  </worldbody>
</mujoco>
